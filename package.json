{
  "name": "starter-kit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npx -y @insforge/cli db migrations up --to 0001 && npm run auth:migrate && npm run db:push",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "npx @better-auth/cli generate",
    "auth:secret": "npx @better-auth/cli secret",
    "auth:migrate": "npx @better-auth/cli migrate --config ./src/lib/auth.ts -y",
    "prepare": "husky"
  },
  "dependencies": {
    "@insforge/sdk": "^1.2.6",
    "better-auth": "^1.1.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "next": "^15.5.22",
    "pg": "^8.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@biomejs/biome": "^1.8.3",
    "@playwright/test": "^1.62.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
