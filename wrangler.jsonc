{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-kit",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".worker-next/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".worker-next/assets"
  },
  "observability": {
    "enabled": true
  }
}
