# ─── App & Auth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="" # Generate with: npx @better-auth/cli secret

# ─── InsForge Backend & Bridge ────────────────────────────────────────────────
NEXT_PUBLIC_INSFORGE_BASE_URL="https://<project-id>.<region>.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="<anon-key>"
INSFORGE_JWT_SECRET="<jwt-secret>" # Get via: npx @insforge/cli secrets get JWT_SECRET

# ─── Database (InsForge Managed Postgres) ───────────────────────────────────
DATABASE_URL="postgresql://postgres:<password>@<host>:5432/insforge?sslmode=require"

# ─── Optional Integrations ──────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
RESEND_API_KEY="re_your_api_key"
