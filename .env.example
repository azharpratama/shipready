# App & Auth URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="" # Generate this securely by running: npx @better-auth/cli secret

# Database (Neon Serverless Postgres)
DATABASE_URL="postgresql://user:password@ep-cold-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Storage (Cloudflare R2 - S3 API)
S3_ACCESS_KEY_ID="your_access_key"
S3_SECRET_ACCESS_KEY="your_secret_key"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_BUCKET_NAME="your_bucket"

# Telemetry (PostHog - Optional)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_project_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Email (Resend - Optional)
RESEND_API_KEY="re_your_api_key"
